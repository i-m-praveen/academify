# Copy this file to .env.local and fill in real values before wiring up
# the contact form to a live email service or CRM.

# Example if using Resend (https://resend.com) to send demo-request emails:
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_EMAIL=sales@academify.example

# Example if forwarding demo requests to a CRM webhook instead:
# CRM_WEBHOOK_URL=

# Analytics (see content/site.ts -> analyticsId, and app/layout.tsx):
# NEXT_PUBLIC_GA_ID=
